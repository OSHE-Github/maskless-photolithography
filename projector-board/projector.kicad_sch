	(text "This board expects +5 V input and uses the DLPA2005 to\nregulate up/down to the values needed for operation. It\nmay draw up to 5 A of current but will likely be less than\nthat in normal operation\n\nGND should be a full ground plane in a 4 layer board.\n\nPlace bypass caps as close as possible to designated pin\n\nGeneral TODOS: Select Micro, Talk to rest of the \ngroup about +5V source. Decide on HMI"
		(exclude_from_sim no)
		(at 14.732 25.654 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a1d3eef6-94b1-4a5c-bbd5-8644cd98d2d1")
	)
